{
  "name": "@dono/ui",
  "version": "0.1.15",
  "description": "Dono design system — shared admin UI components, tokens, and widgets.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdono/ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "exports": {
    ".": "./src/index.js",
    "./components/*": "./src/components/*.jsx",
    "./widgets/*": "./src/widgets/*.jsx",
    "./styling/*": "./src/styling/*.jsx",
    "./utils/*": "./src/utils/*.js",
    "./scss/tokens": "./src/scss/_tokens.scss",
    "./scss/index": "./src/scss/index.scss",
    "./scss/components/*": "./src/scss/components/_*.scss",
    "./package.json": "./package.json",
    "./scss/admin-base": "./src/scss/_admin-base.scss",
    "./scss/dataviews": "./src/scss/_dataviews.scss",
    "./scss/kpi-strip": "./src/scss/_kpi-strip.scss"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "lint": "eslint \"src/**/*.{js,jsx}\""
  },
  "peerDependencies": {
    "@dnd-kit/core": ">=6",
    "@dnd-kit/sortable": ">=10",
    "@dnd-kit/utilities": ">=3",
    "@wordpress/components": ">=28",
    "@wordpress/date": ">=5",
    "@wordpress/element": ">=6",
    "@wordpress/i18n": ">=5",
    "@wordpress/icons": ">=10",
    "lucide-react": ">=1.16",
    "recharts": ">=3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@wordpress/components": "^28.0.0",
    "@wordpress/date": "^5.0.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^5.0.0",
    "@wordpress/icons": "^10.0.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^3.8.1",
    "sass": "^1.80.0",
    "storybook": "^8.4.0",
    "vite": "^5.4.0"
  }
}
